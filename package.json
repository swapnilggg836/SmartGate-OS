{
  "name": "smart-gate-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --workspace=backend run dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "build": "npm run build --workspace=packages/types && npm run build --workspace=backend && npm run build --workspace=frontend",
    "build:types": "npm run build --workspace=packages/types",
    "build:backend": "npm run build:types && npm run prisma:generate --workspace=backend && npm run build --workspace=backend",
    "build:frontend": "npm run build:types && npm run build --workspace=frontend",
    "start:backend": "npm run start --workspace=backend",
    "start:frontend": "npm run start --workspace=frontend",
    "db:push": "npm run prisma:push --workspace=backend",
    "db:seed": "npm run seed --workspace=backend",
    "db:setup": "npm run db:setup --workspace=backend",
    "seed": "npm run seed --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
